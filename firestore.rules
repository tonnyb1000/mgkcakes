rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDocPath() {
      return /databases/$(database)/documents/staffUsers/$(request.auth.uid);
    }

    function hasStaffDoc() {
      return isSignedIn() && exists(staffDocPath());
    }

    function staffData() {
      return get(staffDocPath()).data;
    }

    function isAuthorizedStaff() {
      return hasStaffDoc()
        && staffData().active == true
        && staffData().role in ['staff', 'owner', 'admin'];
    }

    function isAdmin() {
      return hasStaffDoc()
        && staffData().active == true
        && staffData().role in ['owner', 'admin'];
    }

    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    function isValidDateString(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTierEntry(tier) {
      return tier is map
        && tier.tierNumber is int
        && tier.tierNumber >= 1
        && isNonEmptyString(tier.shape)
        && (tier.priceUgx is int || tier.priceUgx is float)
        && tier.priceUgx >= 0;
    }

    function hasValidOptionalTiers(data) {
      return !('tierDetails' in data)
        || (
          data.tierDetails is list
          && data.tierDetails.size() >= 1
          && data.tierDetails.size() <= 10
          && isValidTierEntry(data.tierDetails[0])
          && (data.tierDetails.size() < 2 || isValidTierEntry(data.tierDetails[1]))
          && (data.tierDetails.size() < 3 || isValidTierEntry(data.tierDetails[2]))
          && (data.tierDetails.size() < 4 || isValidTierEntry(data.tierDetails[3]))
          && (data.tierDetails.size() < 5 || isValidTierEntry(data.tierDetails[4]))
        );
    }

    function isValidOrderData(data) {
      return isNonEmptyString(data.orderId)
        && isNonEmptyString(data.customerName)
        && isNonEmptyString(data.customerPhone)
        && isValidDateString(data.orderDate)
        && isValidDateString(data.pickupDate)
        && (data.pickupTime is string)
        && isNonEmptyString(data.description)
        && (data.design is string)
        && (data.colour is string)
        && data.icingType in ['buttercream', 'fondant', 'other']
        && (data.inscriptionOrDecoration is string)
        && (data.size is string)
        && (data.shape is string)
        && (data.tiers is string)
        && (data.totalPriceUgx is int || data.totalPriceUgx is float)
        && (data.amountPaidUgx is int || data.amountPaidUgx is float)
        && (data.balanceUgx is int || data.balanceUgx is float)
        && data.totalPriceUgx >= 0
        && data.amountPaidUgx >= 0
        && data.amountPaidUgx <= data.totalPriceUgx
        && data.balanceUgx == (data.totalPriceUgx - data.amountPaidUgx)
        && data.pickupStatus in ['waiting', 'picked_up']
        && (!('pickedUpDate' in data) || data.pickedUpDate == '' || isValidDateString(data.pickedUpDate))
        && (!('pickedUpTime' in data) || data.pickedUpTime == '' || data.pickedUpTime.matches('^[0-9]{2}:[0-9]{2}$'))
        && (!('pickedUpAt' in data) || data.pickedUpAt is string)
        && hasValidOptionalTiers(data);
    }

    function isValidPaymentData(data) {
      return isNonEmptyString(data.paymentId)
        && data.kind in ['order_deposit', 'order_balance', 'walk_in']
        && (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'mobile_money'])
        && (
          (data.kind == 'walk_in' && data.orderId == '')
          || (data.kind in ['order_deposit', 'order_balance'] && isNonEmptyString(data.orderId))
        )
        && isNonEmptyString(data.description)
        && (data.amountUgx is int || data.amountUgx is float)
        && data.amountUgx > 0
        && isValidDateString(data.receivedDate)
        && data.receivedTime is string
        && data.receivedTime.matches('^[0-9]{2}:[0-9]{2}$')
        && isNonEmptyString(data.receivedAt);
    }

    function isValidCashFlowData(data) {
      return isNonEmptyString(data.entryId)
        && data.type in ['other_sale', 'expense']
        && (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'mobile_money'])
        && isNonEmptyString(data.description)
        && (data.amountUgx is int || data.amountUgx is float)
        && data.amountUgx > 0
        && isValidDateString(data.entryDate)
        && data.entryTime is string
        && data.entryTime.matches('^[0-9]{2}:[0-9]{2}$')
        && isNonEmptyString(data.createdAt)
        && isNonEmptyString(data.recordedByUid)
        && isNonEmptyString(data.recordedByEmail);
    }

    function hasMatchingDepositAfter(orderDocId, orderData) {
      return ('lastPaymentId' in orderData)
        && isNonEmptyString(orderData.lastPaymentId)
        && !exists(/databases/$(database)/documents/payments/$(orderData.lastPaymentId))
        && existsAfter(/databases/$(database)/documents/payments/$(orderData.lastPaymentId))
        && getAfter(/databases/$(database)/documents/payments/$(orderData.lastPaymentId)).data.kind == 'order_deposit'
        && getAfter(/databases/$(database)/documents/payments/$(orderData.lastPaymentId)).data.orderId == orderDocId
        && getAfter(/databases/$(database)/documents/payments/$(orderData.lastPaymentId)).data.amountUgx == orderData.amountPaidUgx;
    }

    function hasMatchingBalancePaymentAfter(orderDocId, oldData, newData) {
      return newData.amountPaidUgx > oldData.amountPaidUgx
        && ('lastPaymentId' in newData)
        && isNonEmptyString(newData.lastPaymentId)
        && newData.lastPaymentId != oldData.get('lastPaymentId', '')
        && !exists(/databases/$(database)/documents/payments/$(newData.lastPaymentId))
        && existsAfter(/databases/$(database)/documents/payments/$(newData.lastPaymentId))
        && getAfter(/databases/$(database)/documents/payments/$(newData.lastPaymentId)).data.kind == 'order_balance'
        && getAfter(/databases/$(database)/documents/payments/$(newData.lastPaymentId)).data.orderId == orderDocId
        && getAfter(/databases/$(database)/documents/payments/$(newData.lastPaymentId)).data.amountUgx == (newData.amountPaidUgx - oldData.amountPaidUgx);
    }

    function hasMatchingOrderAfter(paymentId, payData) {
      return existsAfter(/databases/$(database)/documents/orders/$(payData.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(payData.orderId)).data.get('lastPaymentId', '') == paymentId
        && (
          (
            payData.kind == 'order_deposit'
            && !exists(/databases/$(database)/documents/orders/$(payData.orderId))
            && getAfter(/databases/$(database)/documents/orders/$(payData.orderId)).data.amountPaidUgx == payData.amountUgx
          )
          || (
            payData.kind == 'order_balance'
            && exists(/databases/$(database)/documents/orders/$(payData.orderId))
            && !('deletedAt' in get(/databases/$(database)/documents/orders/$(payData.orderId)).data)
            && getAfter(/databases/$(database)/documents/orders/$(payData.orderId)).data.amountPaidUgx == (
              get(/databases/$(database)/documents/orders/$(payData.orderId)).data.amountPaidUgx + payData.amountUgx
            )
          )
        );
    }

    // Staff allowlist collection: managed by admin/owner.
    match /staffUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Customer cake orders collection: accessible only to active authorised staff/admin.
    match /orders/{orderDocId} {
      allow read: if isAuthorizedStaff();

      allow create: if isAuthorizedStaff()
        && isValidOrderData(request.resource.data)
        && !('deletedAt' in request.resource.data)
        && request.resource.data.orderId == orderDocId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          (
            request.resource.data.amountPaidUgx == 0
            && request.resource.data.get('lastPaymentId', '') == ''
          )
          || (
            request.resource.data.amountPaidUgx > 0
            && hasMatchingDepositAfter(orderDocId, request.resource.data)
          )
        );

      allow update: if !('deletedAt' in resource.data)
        && isValidOrderData(request.resource.data)
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          // Standard staff/admin edit or balance payment (cannot set deletedAt)
          (
            isAuthorizedStaff()
            && !('deletedAt' in request.resource.data)
            && (
              (
                request.resource.data.amountPaidUgx == resource.data.amountPaidUgx
                && request.resource.data.get('lastPaymentId', '') == resource.data.get('lastPaymentId', '')
              )
              || hasMatchingBalancePaymentAfter(orderDocId, resource.data, request.resource.data)
            )
          )
          // Admin-only soft-delete: records who deleted and when, preserves payment/order history
          || (
            isAdmin()
            && isNonEmptyString(request.resource.data.deletedAt)
            && request.resource.data.deletedByUid == request.auth.uid
            && isNonEmptyString(request.resource.data.deletedByEmail)
            && request.resource.data.amountPaidUgx == resource.data.amountPaidUgx
            && request.resource.data.totalPriceUgx == resource.data.totalPriceUgx
            && request.resource.data.balanceUgx == resource.data.balanceUgx
            && request.resource.data.get('lastPaymentId', '') == resource.data.get('lastPaymentId', '')
          )
        );

      // Physical deletion is disabled; admin soft-deletes orders so payment history is retained.
      allow delete: if false;
    }

    // Individual payment transactions (retained for history; never deleted).
    match /payments/{paymentId} {
      allow read: if isAuthorizedStaff();

      allow create: if isAuthorizedStaff()
        && isValidPaymentData(request.resource.data)
        && request.resource.data.paymentId == paymentId
        && request.resource.data.recordedByUid == request.auth.uid
        && (
          request.resource.data.kind == 'walk_in'
          || hasMatchingOrderAfter(paymentId, request.resource.data)
        );

      allow update, delete: if false;
    }

    // Daily cash-flow entries (expenses & other item sales). Immutable audit records.
    match /cashFlowEntries/{entryId} {
      allow read: if isAuthorizedStaff();

      allow create: if isAuthorizedStaff()
        && isValidCashFlowData(request.resource.data)
        && request.resource.data.entryId == entryId
        && request.resource.data.recordedByUid == request.auth.uid;

      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
